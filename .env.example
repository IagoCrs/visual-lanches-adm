# Copie este arquivo para .env.local e preencha os valores.
# O .env.local NUNCA vai para o repositório (está no .gitignore).

# De onde vêm os dados do painel: "mock" (dados de exemplo) ou "database" (Supabase)
NEXT_PUBLIC_API_MODE=mock

# "true" faz o modo mock devolver erro, para testar as telas de erro
NEXT_PUBLIC_MOCK_ERROR=false

# Supabase: painel do projeto > Project Settings > API Keys
# Use a chave "publishable" (começa com sb_publishable_). Ela pode ir para o navegador.
# NUNCA coloque aqui a chave "secret" (sb_secret_) nem a "service_role".
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
